# ==============================================================================
# JustBaddo - Production Environment Variables Template (.env.production)
# Copy to .env.production on the production host and fill in verified values.
# NEVER commit the filled .env.production file to version control.
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate_a_64_character_cryptographically_secure_random_key_here
DJANGO_ALLOWED_HOSTS=justbaddo.com,www.justbaddo.com,api.justbaddo.com

# Domain & Security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_CORS_ALLOWED_ORIGINS=https://justbaddo.com,https://www.justbaddo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://justbaddo.com,https://www.justbaddo.com

# PostgreSQL Production Database
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=justbaddo_db
POSTGRES_USER=justbaddo_app_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# Storage & Static Paths
DJANGO_STATIC_ROOT=/var/www/justbaddo/staticfiles
DJANGO_MEDIA_ROOT=/var/www/justbaddo/media

# Email (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_ses_smtp_api_key_here
DEFAULT_FROM_EMAIL=JustBaddo <noreply@justbaddo.com>

# Logging
DJANGO_LOG_LEVEL=INFO

# Gunicorn Server Tuning
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Authorised Music Streaming Providers (Phase 5/6 placeholders)
SOUNDCLOUD_CLIENT_ID=
YOUTUBE_API_KEY=
STREAMING_CDN_BASE_URL=https://stream.justbaddo.com
