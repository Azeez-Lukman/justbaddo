# JustBaddo Environment Configuration Template
# Copy this file to .env and customize with your deployment credentials.

# Django Core Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Database Settings (PostgreSQL)
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=justbaddo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:8000 http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000 http://127.0.0.1:8000
